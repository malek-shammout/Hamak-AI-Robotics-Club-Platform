# HMK Platform — local environment
# Generated 2026-08-26. Committed? NO — .env.local is gitignored.

NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<your-anon-key>

# Server-only. NEVER prefix with NEXT_PUBLIC_. Required only for S1 scheduled jobs.
# Copy it from: Dashboard -> Project Settings -> API -> service_role
# Left blank deliberately — a service-role key should not be written to disk by tooling.
SUPABASE_SERVICE_ROLE_KEY=

# Used by `npm run db:types`
SUPABASE_PROJECT_REF=<project-ref>
# Used by `npm run test:db` and Supabase management commands. Keep this token
# out of source control and provide it only in the local shell/CI secret store.
SUPABASE_ACCESS_TOKEN=<supabase-personal-access-token>

# Timezone for date rendering (Asia/Damascus per claude.md §7)
NEXT_PUBLIC_DEFAULT_TZ=Asia/Damascus

# ---------------------------------------------------------------------------
# Authenticated Playwright coverage (never commit real credentials)
# ---------------------------------------------------------------------------
# Shared member session used by e2e/auth/auth.setup.ts
E2E_EMAIL=staff-member@example.invalid
E2E_PASSWORD=replace-with-a-throwaway-password

# Role-bearing identities used by e2e/auth/rbac-role-coverage.spec.ts and
# e2e/auth/editorial-revision.spec.ts. These accounts must already exist in
# Supabase and carry the corresponding live role.
E2E_PROJECTS_EMAIL=projects-author@example.invalid
E2E_PROJECTS_PASSWORD=replace-with-a-throwaway-password
E2E_TRAINING_EMAIL=training-author@example.invalid
E2E_TRAINING_PASSWORD=replace-with-a-throwaway-password
E2E_LOGISTICS_EMAIL=logistics-author@example.invalid
E2E_LOGISTICS_PASSWORD=replace-with-a-throwaway-password
E2E_ADMIN_EMAIL=admin-approver@example.invalid
E2E_ADMIN_PASSWORD=replace-with-a-throwaway-password

# Optional URL for a deployed/local test target; defaults to localhost:3100.
E2E_BASE_URL=http://localhost:3100
